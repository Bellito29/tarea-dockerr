# PostgreSQL
POSTGRES_CONTAINER_NAME=biggapp-postgres
POSTGRES_DB=biggapp
POSTGRES_USER=biggapp_user
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5432

# Backend Spring Boot
BACKEND_CONTAINER_NAME=biggapp-backend
BACKEND_PORT=8081
BACKEND_INTERNAL_PORT=8081
SPRING_JPA_HIBERNATE_DDL_AUTO=create
SPRING_SQL_INIT_MODE=always
JWT_SECRET_KEY=change_this_secret_key_to_at_least_64_characters_12345678901234567890
JWT_EXPIRATION_TIME=86400000
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173

# Frontend React/Vite
FRONTEND_CONTAINER_NAME=biggapp-frontend
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:8081/api/rest
VITE_WS_HOST=localhost:8081/api
